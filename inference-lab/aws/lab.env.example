# Copy to aws/lab.env and fill in. aws/lab.env is gitignored.
AWS_PROFILE=default
AWS_REGION=us-east-1

INSTANCE_TYPE=g6.xlarge            # L4 24GB; g6e.xlarge = L40S 48GB; g5.xlarge = A10G (no FP8)
MARKET=spot                        # spot | ondemand
SPOT_FALLBACK=1                    # 1 = launch on-demand if no spot capacity
ROOT_GB=200                        # model cache lives on the root volume so it survives stop/start
AMI_SSM=/aws/service/deeplearning/ami/x86_64/base-oss-nvidia-driver-gpu-ubuntu-22.04/latest/ami-id

KEY_NAME=my-keypair                # existing EC2 key pair name
SSH_KEY=~/.ssh/my-keypair.pem      # matching private key on this laptop
SUBNET_ID=subnet-xxxxxxxx
SECURITY_GROUP_IDS="sg-xxxxxxxx"   # space separated; must allow SSH (22) from your IP
INSTANCE_PROFILE=                  # optional IAM instance profile name (e.g. for SSM)
USE_PRIVATE_IP=0                   # 1 = always use private IP; otherwise public IP if present, else private

NAME=inference-lab                # default; override per command with INSTANCE=replica-a
IDLE_MINUTES=30                    # auto-shutdown when GPU idle and no SSH sessions; 0 = off
