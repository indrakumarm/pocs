# Two existing single-GPU hosts. The runner does not provision or stop instances.
model: Qwen/Qwen3-8B
replicas:
  - name: replica-a
    url_env: REPLICA_A_URL
  - name: replica-b
    url_env: REPLICA_B_URL
out: results/week5
requests: 128
concurrency: [1, 4, 16, 32, 64]
# Open loop: constant arrivals/s, not a concurrency cap. Tune around measured capacity.
request_rates: [0.5, 1, 2, 4]
max_inflight: 256
seed: 17
workloads:
  - name: uniform
    shapes:
      - {input_tokens: 1024, output_tokens: 256, weight: 1}
  - name: mixed
    shapes:
      - {input_tokens: 256, output_tokens: 128, weight: 3}
      - {input_tokens: 4096, output_tokens: 512, weight: 1}
experiments:
  - {tag: single-a, replicas: [replica-a], policy: round-robin}
  - {tag: single-b, replicas: [replica-b], policy: round-robin}
  - {tag: two-rr, replicas: [replica-a, replica-b], policy: round-robin}
  - {tag: two-least, replicas: [replica-a, replica-b], policy: least-inflight}
